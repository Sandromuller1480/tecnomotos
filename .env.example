# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Configuration (Private/Service Role)
# WARNING: Keep this secret! Do not expose this in frontend components.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Initial Owner Account Bootstrap (Only used during deployment/first run)
OWNER_EMAIL=admin@tecnomotos.com.br
OWNER_PASSWORD=change-me-to-a-secure-password

# Payments (Stripe Configuration)
# Note: Always keep in test mode for initial foundation stage
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_MODE=test

# Fiscal Configuration (NF-e MT)
# Keep mock mode until a fiscal provider is intentionally enabled.
FISCAL_PROVIDER=mock
FISCAL_ENVIRONMENT=mock
FISCAL_PRODUCTION_ENABLED=false
FISCAL_UF=MT
FISCAL_MODEL=55
FISCAL_CNPJ=
FISCAL_IE=
FISCAL_CRT=
FISCAL_CERTIFICATE_PATH=
FISCAL_CERTIFICATE_BASE64=
FISCAL_CERTIFICATE_PASSWORD=
FISCAL_NFE_SERIES=1

# Focus NFe (leave empty while FISCAL_PROVIDER=mock)
FOCUS_NFE_HOMOLOGATION_TOKEN=
FOCUS_NFE_PRODUCTION_TOKEN=
# Configure o mesmo valor no webhook da Focus usando o cabecalho abaixo.
FOCUS_NFE_WEBHOOK_SECRET=
